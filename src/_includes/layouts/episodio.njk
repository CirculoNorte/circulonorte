---
layout: layouts/base.njk
---
{% set spot = audio | spotifyEmbed %}
{% set yt = audio | youtubeEmbed %}
<article class="articulo">
<header class="articulo__cabeza">
<a class="antetitulo" href="/en-circulo/">En Círculo{% if numero %} · Episodio {{ numero }}{% endif %}</a>
<h1>{{ title }}</h1>
{% if bajada %}<p class="bajada">{{ bajada }}</p>{% endif %}
<p class="firma">{% if invitados %}<strong>Con {{ invitados }}</strong><span aria-hidden="true">·</span>{% endif %}<time datetime="{{ page.date | fechaISO }}">{{ page.date | fecha }}</time>{% if duracion %}<span aria-hidden="true">·</span><span>{{ duracion }}</span>{% endif %}</p>
</header>
{% if spot %}
<div class="insertado insertado--audio"><iframe src="{{ spot }}" title="{{ title }}" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe></div>
{% elif yt %}
<div class="insertado insertado--video"><iframe src="{{ yt }}" title="{{ title }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
{% elif audio %}
<p style="margin-top:24px"><a class="boton boton--oscuro" href="{{ audio }}" rel="noopener">Escuchar el episodio</a></p>
{% endif %}
<div class="cuerpo">
{{ content | safe }}
</div>
{% include "partes/compartir.njk" %}
</article>
