{% from "partes/macros.njk" import cerros, avatar, play %}
<section class="cabeza-seccion">
<div class="cabeza-seccion__fondo">{{ cerros(-500, 0, "#FBEFE0", true) }}</div>
<div class="contenedor cabeza-seccion__texto">
<div class="antetitulo">{{ site.nombre }}</div>
<h1>{{ titulo }}</h1>
<p>{{ descripcion }}</p>
{% if filtros %}
<div class="filtros" style="margin-top:22px">
<a class="pildora" href="/territorio/"{% if page.url == "/territorio/" %} aria-current="page"{% endif %}>Toda la región</a>
<a class="pildora" href="/territorio/elqui/"{% if page.url == "/territorio/elqui/" %} aria-current="page"{% endif %}>Elqui</a>
<a class="pildora" href="/territorio/limari/"{% if page.url == "/territorio/limari/" %} aria-current="page"{% endif %}>Limarí</a>
<a class="pildora" href="/territorio/choapa/"{% if page.url == "/territorio/choapa/" %} aria-current="page"{% endif %}>Choapa</a>
</div>
{% endif %}
</div>
</section>

<section class="bloque">
<div class="contenedor">
{% if formato == "columnas" %}
<div class="tres">
{% for c in items %}
{% set a = c.data.autor | autor(collections.autores) %}
<article class="columna" style="border-bottom:1px solid var(--arena-linea)">
{{ avatar(a) }}
<div class="columna__texto">
<span class="columna__autor">{{ a.data.title if a else site.nombre }} · {{ c.date | fecha }}</span>
<h3><a href="{{ c.url }}">{{ c.data.title }}</a></h3>
</div>
</article>
{% else %}<p class="vacio">Pronto, las primeras publicaciones.</p>{% endfor %}
</div>
{% elif formato == "videos" %}
<div class="tres">
{% for m in items %}
<article class="tarjeta">
<a class="tarjeta__imagen" href="{{ m.url }}" style="position:relative" aria-label="Ver: {{ m.data.title }}">{% if m.data.imagen %}<img src="{{ m.data.imagen }}" alt="" loading="lazy">{% else %}{{ cerros(900, 210, "#F3DCD6") }}{% endif %}<span class="boton-play" style="width:64px;height:64px;margin:-32px 0 0 -32px">{{ play(24) }}</span></a>
<span class="antetitulo">{{ m.data.tipo or "Editorial" }}{% if m.data.duracion %} · {{ m.data.duracion }}{% endif %}</span>
<h3><a href="{{ m.url }}">{{ m.data.title }}</a></h3>
</article>
{% else %}<p class="vacio">Pronto, los primeros videos.</p>{% endfor %}
</div>
{% elif formato == "episodios" %}
<ol class="episodios" style="max-width:820px">
{% for e in items %}
<li class="episodio">
<span class="episodio__num">{{ e.data.numero or "·" }}</span>
<div class="episodio__texto">
<a href="{{ e.url }}">{{ e.data.title }}</a>
<span class="episodio__meta">{% if e.data.invitados %}Con {{ e.data.invitados }} · {% endif %}{{ e.date | fecha }}{% if e.data.duracion %} · {{ e.data.duracion }}{% endif %}</span>
</div>
<a class="boton-redondo" href="{{ e.url }}" aria-label="Escuchar: {{ e.data.title }}">{{ play() }}</a>
</li>
{% else %}<li class="vacio">El primer episodio viene en camino.</li>{% endfor %}
</ol>
{% elif formato == "breves" %}
<div style="max-width:820px">
{% for n in items %}
<article class="columna">
<div class="columna__texto">
<span class="antetitulo">{{ n.data.comuna or "Región" }} · {{ n.date | fecha }}</span>
<h3><a href="{{ n.url }}">{{ n.data.title }}</a></h3>
</div>
</article>
{% else %}<p class="vacio">Sin noticias por ahora.</p>{% endfor %}
</div>
{% elif formato == "autores" %}
<div class="tres">
{% for a in items %}
<article class="columna">
{{ avatar(a) }}
<div class="columna__texto">
<h3><a href="{{ a.url }}">{{ a.data.title }}</a></h3>
{% if a.data.cargo %}<span class="columna__autor">{{ a.data.cargo }}</span>{% endif %}
</div>
</article>
{% endfor %}
</div>
{% else %}
<div class="tres">
{% for t in items %}{% include "partes/tarjeta.njk" %}{% else %}<p class="vacio">Pronto, los primeros reportajes.</p>{% endfor %}
</div>
{% endif %}

{% if pagination and (pagination.href.previous or pagination.href.next) %}
<nav class="paginacion" aria-label="Paginación">
{% if pagination.href.previous %}<a class="boton boton--borde" href="{{ pagination.href.previous }}">← Más recientes</a>{% else %}<span></span>{% endif %}
{% if pagination.href.next %}<a class="boton boton--borde" href="{{ pagination.href.next }}">Anteriores →</a>{% endif %}
</nav>
{% endif %}
</div>
</section>
